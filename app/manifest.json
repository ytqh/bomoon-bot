{
  "name": "bomoon-bot",
  "url": "https://github.com/ytqh/bomoon-bot",
  "hook_attributes": { "url": "https://pa-runtime-production.up.railway.app/github/webhook" },
  "public": true,
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "pull_requests": "write",
    "checks": "write",
    "issues": "read"
  },
  "default_events": ["pull_request", "issue_comment"]
}
